# 网络质量探测节点配置
# 用记事本或普通文本编辑器修改本文件，保存后重新运行程序才会生效。
# 以 # 开头的行是注释。某一项不写时，使用程序内置的默认值。
# 优先级：命令行参数 > 系统环境变量 > 本文件 > 内置默认值。
# 本文件不存在也不会报错，程序会按内置默认值启动。
# 下面这些值就是内置默认值，不改也能和以前的客户端配合使用。

# 反射服务监听哪块网卡。
# 0.0.0.0 表示本机所有网卡，同一局域网或公网可以连过来。
# 只在这台电脑上自己试，改成 127.0.0.1。
NQ_BIND=0.0.0.0

# TCP 反射端口。手机里「合作反射 TCP」要填同一个数字。
# 填 0 表示关闭 TCP。
NQ_TCP_PORT=19090

# UDP 反射端口。手机里「合作反射 UDP」要填同一个数字。
# 填 0 表示关闭 UDP。
NQ_UDP_PORT=19091

# 回显口令。它会写进探测包，用来挡住无关的访问，不是加密。
# 留空表示不检查口令，谁都能让本机把探测包送回去。
# 最长 32 字节（一般就是 32 个英文字符）。手机里对应「目标回显口令」。
# 这和下面的节点口令不是同一个东西。
NQ_TOKEN=

# 工作模式，三选一：
#   reflector  只做反射：把收到的探测包原样送回去。这是默认。
#   node       只做检测节点：按手机的指令去测别的地址。
#   both       反射和节点一起开。
NQ_MODE=reflector

# 节点控制地址。手机「管理节点」里填的就是这个地址。
# 默认 127.0.0.1 只允许本机连接，外网连不上，这样更安全。
# 要让手机来用，改成 0.0.0.0:8443，并尽量放在 HTTPS 反向代理后面。
NQ_CONTROL_ADDR=127.0.0.1:8443

# 节点口令。留空表示公开节点：谁能连上控制端口，谁就能在上限内发起探测。
# 写上口令以后，手机「管理节点」里必须填同一个口令，否则不会向目标发包。
# 不要把真实口令发到聊天里，也不要提交到仓库。
NQ_NODE_TOKEN=

# 是否允许节点去测本机和局域网地址。只能写 true 或 false。
# 云服务器的元数据地址（例如 169.254.169.254）始终禁止，改成 true 也不会放行。
# 平常保持 false。只有故意测机房内网时才改成 true。
NQ_ALLOW_PRIVATE=false

# 额外允许探测的网段，用英文逗号分隔。
# 例如 10.1.2.0/24,192.168.1.10
# 留空表示没有额外放行。
NQ_ALLOW_NETS=

# 控制端口自己的 HTTPS 证书和私钥。两个都填才启用 TLS，只填一个会启动失败。
# 留空则使用明文 HTTP。不要把明文的控制端口直接暴露到公网。
NQ_TLS_CERT=
NQ_TLS_KEY=

# 是否把每一个收发的包都写进日志。只能写 true 或 false。
# 平常保持 false。排查问题时再改成 true。
NQ_VERBOSE=false
