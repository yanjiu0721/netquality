[Unit]
Description=NetQuality UDP/TCP reflector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 端口、回显口令和模式写在 /opt/netquality/.env。
# 默认 NQ_MODE=reflector，只做反射。改完 .env 后执行 systemctl restart。
WorkingDirectory=/opt/netquality
ExecStart=/opt/netquality/netquality-reflector
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
