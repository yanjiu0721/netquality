[Unit]
Description=网络质量探测中心
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/netquality
ExecStart=/opt/netquality/netquality-reflector
Environment=NQ_MODE=center
Environment=NQ_CENTER_DIR=/etc/netquality/center
Environment=NQ_CONTROL_ADDR=127.0.0.1:8443
ReadOnlyPaths=/etc/netquality/center
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
